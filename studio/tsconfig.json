{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": []
  },
  "include": ["**/*.ts", "**/*.tsx", "../site.config.ts", "../shared/**/*.ts"],
  "exclude": ["node_modules", "dist", ".sanity"]
}
