---
/**
 * Editorial-Header: zentrierte Serifen-Wortmarke mit Claim, Navigation darunter zwischen feinen Linien,
 * Sprachwahl als Textlinks oben rechts.
 */
import SanityImage from '../../components/ui/SanityImage.astro'
import { t } from '../../lib/i18n'
import type { HeaderProps } from '../types'

type Props = HeaderProps
const { lang, siteName, homeHref, logo, tagline, nav, languages } = Astro.props
const s = t(lang)
---

<header class="site-header container">
  <nav class="langs" aria-label={s.language}>
    {
      languages.map((l) =>
        l.current ? (
          <span aria-current="true" lang={l.lang}>
            {l.lang.toUpperCase()}
          </span>
        ) : (
          <a href={l.href} hreflang={l.lang} lang={l.lang} title={l.label}>
            {l.lang.toUpperCase()}
          </a>
        ),
      )
    }
  </nav>

  <div class="brand">
    <a href={homeHref} class="brand__link" aria-label={`${siteName} – ${s.home}`}>
      {
        logo?.asset ? (
          <SanityImage image={logo} widths={[400]} sizes="200px" alt={siteName} priority />
        ) : (
          <span aria-hidden="true">{siteName}</span>
        )
      }
    </a>
    {tagline && <p class="brand__tagline">{tagline}</p>}
  </div>

  <nav class="mainnav" aria-label={s.mainNav}>
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={item.href} aria-current={item.current ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    padding-top: var(--space-6);
  }
  .langs {
    position: absolute;
    top: var(--space-3);
    right: 0;
    display: flex;
    gap: var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
  }
  .langs a,
  .langs span {
    display: inline-block;
    padding: var(--space-1) var(--space-2);
  }
  .langs span {
    color: var(--color-text-muted);
    border-bottom: 2px solid var(--color-primary);
  }
  .brand {
    text-align: center;
    padding-block: var(--space-4) var(--space-5);
  }
  .brand__link {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 1.6rem + 2.4vw, 3.4rem);
    font-weight: 700;
    font-style: italic;
    letter-spacing: -0.02em;
    color: var(--color-heading);
    text-decoration: none;
  }
  .brand__link :global(img) {
    margin-inline: auto;
    height: 3rem;
    width: auto;
  }
  .brand__tagline {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-style: italic;
  }
  .mainnav {
    border-block: var(--border-width) solid var(--color-border);
  }
  .mainnav ul {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    margin: 0;
    padding: var(--space-2) 0;
    list-style: none;
  }
  .mainnav a {
    display: block;
    padding: var(--space-2) 0;
    color: var(--color-text);
    text-decoration: none;
  }
  .mainnav a:hover,
  .mainnav a[aria-current='page'] {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
  }
</style>
