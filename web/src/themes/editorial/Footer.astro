---
/** Editorial-Footer: zentrierter „Über uns“-Text, Linkspalten darunter, Rechtliches unten */
import { t } from '../../lib/i18n'
import type { FooterProps } from '../types'

type Props = FooterProps
const { lang, siteName, homeHref, about, columns, legal, social, rssHref, email } = Astro.props
const s = t(lang)
---

<footer class="site-footer">
  <div class="container footer__inner">
    <section class="footer__about" aria-labelledby="footer-about">
      <h2 id="footer-about" class="visually-hidden">{s.aboutUs}</h2>
      <a class="footer__brand" href={homeHref}>{siteName}</a>
      {about && <p class="footer__text">{about}</p>}
      {email && <p><a href={`mailto:${email}`}>{email}</a></p>}
    </section>

    <div class="footer__cols">
      {
        columns.map((col, i) => (
          <nav aria-labelledby={`footer-col-${i}`}>
            <h2 id={`footer-col-${i}`} class="footer__heading">
              {col.title}
            </h2>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <ul class="footer__legal">
      {
        [...legal, ...social, { label: s.rss, href: rssHref }].map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))
      }
    </ul>
    <p class="footer__copy">{s.copyright(new Date().getFullYear(), siteName)}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-section);
    background: var(--color-footer-bg);
    color: var(--color-footer-text);
  }
  .footer__inner {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-8);
  }
  .footer__about {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    text-align: center;
  }
  .footer__brand {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 700;
    font-size: 1.75rem;
    color: var(--color-footer-heading);
    text-decoration: none;
  }
  .footer__text {
    max-width: 40rem;
  }
  .footer__cols {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    padding-top: var(--space-5);
    border-top: var(--border-width) solid var(--color-border);
  }
  .footer__heading {
    font-size: var(--text-base);
    font-style: italic;
    margin-bottom: var(--space-2);
  }
  .site-footer ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer__cols li + li {
    margin-top: var(--space-1);
  }
  .site-footer a {
    color: inherit;
  }
  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-sm);
  }
  .footer__copy {
    text-align: center;
    font-size: var(--text-sm);
  }
</style>
