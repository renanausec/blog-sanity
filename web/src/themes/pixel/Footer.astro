---
import { t } from '../../lib/i18n'
import type { FooterProps } from '../types'

type Props = FooterProps
const { lang, siteName, homeHref, text, nav, categories, legal, social, rssHref } = Astro.props
const s = t(lang)
const year = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="container footer__grid">
    <div class="footer__about">
      <a class="footer__brand" href={homeHref}>{siteName.toLowerCase()}<span>.</span></a>
      {text && <p>{text}</p>}
    </div>

    {
      categories.length > 0 && (
        <nav aria-labelledby="footer-categories">
          <h2 id="footer-categories" class="footer__heading">{s.categories}</h2>
          <ul>
            {categories.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      nav.length > 0 && (
        <nav aria-labelledby="footer-links">
          <h2 id="footer-links" class="footer__heading">{siteName}</h2>
          <ul>
            {nav.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p>{s.copyright(year, siteName)}</p>
      <ul class="footer__inline">
        {
          legal.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
        {
          social.map((l) => (
            <li>
              <a href={l.href} rel="me noopener">
                {l.label}
              </a>
            </li>
          ))
        }
        <li><a href={rssHref}>{s.rss}</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-section);
    background: var(--color-footer-bg);
    color: var(--color-footer-text);
    font-size: var(--text-sm);
  }
  .site-footer a {
    color: inherit;
  }
  .site-footer a:hover {
    color: var(--color-footer-heading);
  }
  .site-footer :focus-visible {
    outline-color: var(--color-footer-heading);
  }
  .footer__grid {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-8);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
  .footer__about p {
    margin-top: var(--space-3);
    max-width: 32rem;
  }
  .footer__brand {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 1.75rem;
    letter-spacing: -0.04em;
    text-decoration: none;
    color: var(--color-footer-heading) !important;
  }
  .footer__brand span {
    color: var(--color-focus);
  }
  .footer__heading {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-footer-heading);
    margin-bottom: var(--space-3);
  }
  .site-footer ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer li + li {
    margin-top: var(--space-2);
  }
  .footer__bottom {
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }
  .footer__bottom-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-4);
  }
  .footer__inline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }
  .site-footer .footer__inline li + li {
    margin-top: 0;
  }
</style>
