---
/**
 * Pixel-Footer: dunkel, „Über uns“-Text links (GEO), Linkspalten rechts,
 * Rechtliches und Copyright in der Fußzeile.
 */
import { t } from '../../lib/i18n'
import type { FooterProps } from '../types'

type Props = FooterProps
const { lang, siteName, homeHref, about, columns, legal, social, rssHref, email } = Astro.props
const s = t(lang)
const year = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="container footer__grid">
    <section class="footer__about" aria-labelledby="footer-about">
      <h2 id="footer-about" class="visually-hidden">{s.aboutUs}</h2>
      <a class="footer__brand" href={homeHref}>{siteName.toLowerCase()}<span>.</span></a>
      {about && <p>{about}</p>}
      {email && <p class="footer__contact"><a href={`mailto:${email}`}>{email}</a></p>}
    </section>

    {
      columns.map((col, i) => (
        <nav aria-labelledby={`footer-col-${i}`}>
          <h2 id={`footer-col-${i}`} class="footer__heading">
            {col.title}
          </h2>
          <ul>
            {col.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p>{s.copyright(year, siteName)}</p>
      <ul class="footer__inline">
        {
          [...legal, ...social].map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
        <li><a href={rssHref}>{s.rss}</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-section);
    background: var(--color-footer-bg);
    color: var(--color-footer-text);
    font-size: var(--text-sm);
  }
  .site-footer a {
    color: inherit;
  }
  .site-footer a:hover {
    color: var(--color-footer-heading);
  }
  .site-footer :focus-visible {
    outline-color: var(--color-footer-heading);
  }
  .footer__grid {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-8);
  }
  @media (min-width: 48rem) {
    .footer__grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .footer__about {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 64rem) {
    .footer__grid {
      grid-template-columns: 2fr repeat(3, 1fr);
    }
    .footer__about {
      grid-column: auto;
    }
  }
  .footer__about p {
    margin-top: var(--space-3);
    max-width: 34rem;
    line-height: 1.6;
  }
  .footer__brand {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 1.75rem;
    letter-spacing: -0.04em;
    text-decoration: none;
    color: var(--color-footer-heading) !important;
  }
  .footer__brand span {
    color: var(--color-focus);
  }
  .footer__heading {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-footer-heading);
    margin-bottom: var(--space-3);
  }
  .site-footer ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer li + li {
    margin-top: var(--space-2);
  }
  .footer__bottom {
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }
  .footer__bottom-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-4);
  }
  .footer__inline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }
  .site-footer .footer__inline li + li {
    margin-top: 0;
  }
</style>
