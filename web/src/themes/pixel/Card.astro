---
/**
 * Pixel-Karte: Rubrik in Versalien, kräftige Überschrift, Datum.
 * Varianten: lead (Aufmacher), default (Raster), compact (Textliste mit Mini-Bild).
 */
import SanityImage from '../../components/ui/SanityImage.astro'
import Rating from '../../components/ui/Rating.astro'
import { docPath } from '../../../../shared/routing'
import { categoryPath, formatDate, pick, t } from '../../lib/i18n'
import type { CardProps } from '../types'

type Props = CardProps
const { item, variant = 'default', headingLevel = 3, priority = false } = Astro.props
const s = t(item.language)
const href = docPath(item._type, item.language, item.slug)
const Heading = `h${headingLevel}` as 'h2' | 'h3'
const typeLabel = item._type !== 'article' ? s.type[item._type] : undefined
const sizes = {
  lead: '(min-width: 64rem) 48rem, 100vw',
  default: '(min-width: 64rem) 24rem, (min-width: 40rem) 50vw, 100vw',
  compact: '6rem',
}[variant]
const widths = { lead: [480, 800, 1200], default: [400, 640, 800], compact: [192] }[variant]
const aspect = variant === 'compact' ? 1 : variant === 'lead' ? 16 / 9 : 5 / 3
---

<article class:list={['card', `card--${variant}`]}>
  {
    item.mainImage?.asset && (
      <div class="card__media">
        <SanityImage image={item.mainImage} widths={widths} sizes={sizes} aspect={aspect} priority={priority} decorative />
      </div>
    )
  }
  <div class="card__body">
    <p class="card__kicker">
      {
        item.category && (
          <a class="kicker" href={categoryPath(item.category, item.language)}>
            {pick(item.category.title, item.language)}
          </a>
        )
      }
      {typeLabel && <span class="card__type">{typeLabel}</span>}
    </p>
    <Heading class="card__title">
      <a href={href}>{item.title}</a>
    </Heading>
    {typeof item.rating === 'number' && item._type === 'review' && <Rating value={item.rating} lang={item.language} />}
    {variant !== 'compact' && item.excerpt && <p class="card__excerpt">{item.excerpt}</p>}
    {
      item.publishedAt && (
        <p class="meta">
          <time datetime={item.publishedAt}>{formatDate(item.publishedAt, item.language)}</time>
        </p>
      )
    }
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .card__media :global(img) {
    width: 100%;
    background: var(--color-surface-alt);
  }
  .card__body {
    display: grid;
    gap: var(--space-2);
  }
  .card__kicker {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
    min-height: 1em;
  }
  .card__kicker a {
    position: relative;
    z-index: 1;
  }
  .card__type {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .card__title {
    font-size: var(--text-lg);
  }
  .card__title a {
    color: var(--color-heading);
    text-decoration: none;
  }
  /* Ganze Karte klickbar, Rubrik-Link bleibt eigenständig */
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card:hover .card__title a {
    color: var(--color-primary);
  }
  .card__title a:focus-visible {
    outline: none;
  }
  .card:has(.card__title a:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 4px;
  }
  .card__excerpt {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card--lead .card__title {
    font-size: var(--text-3xl);
  }
  .card--lead .card__excerpt {
    font-size: var(--text-base);
    font-weight: var(--weight-lead);
    color: var(--color-text);
    -webkit-line-clamp: 4;
  }

  .card--compact {
    grid-template-columns: 5rem 1fr;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-bottom: var(--border-width) solid var(--color-border);
  }
  .card--compact .card__title {
    font-size: var(--text-base);
  }
  .card--compact:not(:has(.card__media)) {
    grid-template-columns: 1fr;
  }
</style>
