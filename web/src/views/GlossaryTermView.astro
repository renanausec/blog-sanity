---
import BaseLayout from '../layouts/BaseLayout.astro'
import ArticleLayout from '@theme/ArticleLayout.astro'
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'
import ShortAnswer from '../components/ui/ShortAnswer.astro'
import Faq from '../components/ui/Faq.astro'
import RichText from '../components/content/RichText.astro'
import Related from '../components/ui/Related.astro'
import { docPath } from '../../../shared/routing'
import { loadContent, mentionedIn } from '../lib/content'
import { categoryPath, pick, refHref, t } from '../lib/i18n'
import { breadcrumbNode, definedTermNode, faqNode, ids, webPageNode, type Crumb } from '../lib/jsonld'
import type { Route } from '../lib/routes'
import type { GlossaryTerm } from '../lib/types'

interface Props {
  route: Route
}
const { route } = Astro.props
const term = (route.data as { doc: GlossaryTerm }).doc
const lang = term.language
const s = t(lang)
const indexPath = docPath('glossaryIndex', lang)
const crumbs: Crumb[] = [
  { name: s.home, path: docPath('home', lang) },
  { name: s.glossary, path: indexPath },
  { name: term.title, path: route.path },
]
const definitionLabel = s.whatIs(term.title)
const content = await loadContent()
const usedIn = mentionedIn(content, term, 6)
const categoryName = term.category ? pick(term.category.title, lang) : undefined
const jsonLd = [
  webPageNode({
    path: route.path,
    lang,
    title: term.title,
    description: term.shortDefinition,
    dateModified: term.updatedAt ?? term._updatedAt,
    hasBreadcrumb: true,
    speakable: ['h1', '.short-answer'],
    mainEntity: { '@id': ids.term(lang, term.slug) },
  }),
  breadcrumbNode(route.path, crumbs),
  definedTermNode(term),
  faqNode(route.path, term.faq ?? []),
]
const related = (term.relatedTerms ?? [])
  .map((r) => ({ label: r.title, href: refHref(r, lang), def: r.shortDefinition }))
  .filter((r) => r.href)
---

<BaseLayout lang={lang} title={s.seo.term(term.title)} description={term.shortDefinition} route={route} seo={term.seo} jsonLd={jsonLd}>
  <ArticleLayout lang={lang} title={term.title} kicker={{ label: s.glossary, href: indexPath }}>
    <Breadcrumbs slot="breadcrumbs" crumbs={crumbs} lang={lang} />
    <ShortAnswer slot="lead" text={term.shortDefinition} lang={lang} label={definitionLabel} />
    {
      ((term.alternateNames?.length ?? 0) > 0 || (term.category && categoryName)) && (
        <p slot="meta" class="meta term-meta">
          {(term.alternateNames?.length ?? 0) > 0 && (
            <span>
              {s.alsoKnownAs}: {term.alternateNames!.join(', ')}
            </span>
          )}
          {term.category && categoryName && (
            <span>
              {s.category}: <a href={categoryPath(term.category, lang)}>{categoryName}</a>
            </span>
          )}
        </p>
      )
    }

    <RichText value={term.body} />

    {
      related.length > 0 && (
        <section class="related-terms" aria-labelledby="related-terms-title">
          <h2 id="related-terms-title">{s.relatedTerms}</h2>
          <ul>
            {related.map((r) => (
              <li>
                <a href={r.href}>{r.label}</a>
                {r.def && <span class="meta"> – {r.def}</span>}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <Faq items={term.faq} lang={lang} />

    <Related slot="after" items={usedIn} lang={lang} title={s.mentionedIn} />
  </ArticleLayout>
</BaseLayout>

<style>
  .term-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }
  .related-terms h2 {
    margin-bottom: var(--space-3);
  }
  .related-terms ul {
    margin: 0;
    padding-left: 1.2em;
    display: grid;
    gap: var(--space-2);
  }
  .related-terms a {
    font-weight: var(--weight-bold);
  }
</style>
