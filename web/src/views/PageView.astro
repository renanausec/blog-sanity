---
/** Einfache Seite (Kontakt, Redaktionelle Richtlinien, Impressum, Datenschutz …) */
import BaseLayout from '../layouts/BaseLayout.astro'
import ArticleLayout from '@theme/ArticleLayout.astro'
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'
import Faq from '../components/ui/Faq.astro'
import RichText from '../components/content/RichText.astro'
import { docPath } from '../../../shared/routing'
import { formatDate, t } from '../lib/i18n'
import { loadContent } from '../lib/content'
import { breadcrumbNode, faqNode, ids, webPageNode, type Crumb } from '../lib/jsonld'
import type { Route } from '../lib/routes'
import type { Page } from '../lib/types'

interface Props {
  route: Route
}
const { route } = Astro.props
const page = (route.data as { doc: Page }).doc
/** schema.org-Seitentyp je Seitentyp im Studio */
const pageSchemaType: Record<string, string> = {
  generic: 'WebPage',
  about: 'AboutPage',
  editorialPolicy: 'AboutPage',
  contact: 'ContactPage',
  imprint: 'WebPage',
  privacy: 'WebPage',
}
const lang = page.language
const s = t(lang)
// Kontaktseite: E-Mail kommt zentral aus Einstellungen → Organisation
const { settings } = await loadContent()
const contactEmail = page.pageType === 'contact' ? settings.organization?.email : undefined
const crumbs: Crumb[] = [
  { name: s.home, path: docPath('home', lang) },
  { name: page.title, path: route.path },
]
const jsonLd = [
  webPageNode({
    path: route.path,
    lang,
    title: page.title,
    description: page.intro,
    dateModified: page.updatedAt,
    hasBreadcrumb: true,
    type: pageSchemaType[page.pageType ?? 'generic'],
    about: page.pageType === 'about' || page.pageType === 'editorialPolicy' ? { '@id': ids.organization() } : undefined,
  }),
  breadcrumbNode(route.path, crumbs),
  faqNode(route.path, page.faq ?? []),
]
---

<BaseLayout lang={lang} title={page.title} description={page.intro} route={route} seo={page.seo} jsonLd={jsonLd}>
  <ArticleLayout lang={lang} title={page.title}>
    <Breadcrumbs slot="breadcrumbs" crumbs={crumbs} lang={lang} />
    {page.intro && <p slot="lead" class="page-intro">{page.intro}</p>}
    {
      page.updatedAt && (
        <p slot="meta" class="meta">
          {s.updatedOn} <time datetime={page.updatedAt}>{formatDate(page.updatedAt, lang)}</time>
        </p>
      )
    }
    {
      contactEmail && (
        <section class="contact-box" aria-labelledby="contact-box-title">
          <h2 id="contact-box-title">{s.writeUs}</h2>
          <p>
            <a class="button" href={`mailto:${contactEmail}`}>
              {contactEmail}
            </a>
          </p>
        </section>
      )
    }
    <RichText value={page.body} />
    <Faq items={page.faq} lang={lang} />
  </ArticleLayout>
</BaseLayout>

<style>
  .contact-box {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    background: var(--color-surface-alt);
    border-radius: var(--radius-lg);
    max-width: var(--measure);
  }
  .contact-box h2 {
    font-size: var(--text-xl);
  }
  .page-intro {
    font-size: var(--text-lead);
    font-weight: var(--weight-lead);
    max-width: var(--measure);
  }
</style>
