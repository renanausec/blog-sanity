---
/** Artikel, Vergleich und Review – gemeinsames Gerüst, typspezifischer Mittelteil */
import BaseLayout from '../layouts/BaseLayout.astro'
import ArticleLayout from '@theme/ArticleLayout.astro'
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'
import Byline from '../components/ui/Byline.astro'
import ShortAnswer from '../components/ui/ShortAnswer.astro'
import Toc from '../components/ui/Toc.astro'
import Faq from '../components/ui/Faq.astro'
import AuthorBox from '../components/ui/AuthorBox.astro'
import Related from '../components/ui/Related.astro'
import RichText from '../components/content/RichText.astro'
import ComparisonList from '../components/content/ComparisonList.astro'
import ReviewSummary from '../components/content/ReviewSummary.astro'
import Table from '../components/content/blocks/Table.astro'
import KeyTakeaways from '../components/ui/KeyTakeaways.astro'
import Sources from '../components/ui/Sources.astro'
import { docPath } from '../../../shared/routing'
import { loadContent, relatedFor } from '../lib/content'
import { categoryPath, pick, readingTime, refHref, t } from '../lib/i18n'
import { absoluteImage } from '../lib/images'
import {
  articleNode,
  breadcrumbNode,
  comparisonListNode,
  faqNode,
  mentionNodes,
  personNode,
  plain,
  productReviewNodes,
  webPageNode,
  type Crumb,
} from '../lib/jsonld'
import type { Route } from '../lib/routes'
import type { Comparison, EditorialDoc, Review } from '../lib/types'

interface Props {
  route: Route
}
const { route } = Astro.props
const doc = (route.data as { doc: EditorialDoc }).doc
const lang = doc.language
const s = t(lang)
const content = await loadContent()

const categoryName = doc.category ? pick(doc.category.title, lang) : undefined
const crumbs: Crumb[] = [
  { name: s.home, path: docPath('home', lang) },
  ...(doc.category && categoryName ? [{ name: categoryName, path: categoryPath(doc.category, lang) }] : []),
  { name: doc.title, path: route.path },
]

const comparison = doc._type === 'comparison' ? (doc as Comparison) : undefined
const review = doc._type === 'review' ? (doc as Review) : undefined

const fullText = [doc.excerpt, ...(doc.keyTakeaways ?? []), plain(comparison?.intro), plain(doc.body), review?.verdict]
  .filter(Boolean)
  .join(' ')
const minutes = readingTime(fullText)
const faq = doc.faq ?? []
const related = relatedFor(content, doc, 3)
const policyHref = refHref(content.settings.legalPages?.[lang]?.editorialPolicy, lang)

// Strukturierte Daten
const image = await absoluteImage(doc.mainImage)
const imageInfo = image ? { ...image, caption: doc.mainImage?.caption ?? doc.mainImage?.alt, credit: doc.mainImage?.credit } : undefined
const people = [...doc.authors, ...(doc.reviewedBy && !doc.authors.some((a) => a._id === doc.reviewedBy!._id) ? [doc.reviewedBy] : [])]
const peopleImages = await Promise.all(people.map((a) => absoluteImage(a.image, 400, 1)))
const productImage = review ? await absoluteImage(review.product.image, 800, undefined) : undefined
const modified = doc.updatedAt ?? doc.publishedAt

const jsonLd = [
  webPageNode({
    path: route.path,
    lang,
    title: doc.title,
    description: doc.excerpt,
    primaryImage: imageInfo,
    datePublished: doc.publishedAt,
    dateModified: modified,
    hasBreadcrumb: true,
    reviewedBy: doc.reviewedBy,
    speakable: ['h1', '.short-answer', '.takeaways'],
  }),
  breadcrumbNode(route.path, crumbs),
  articleNode({
    type: doc._type === 'article' ? 'BlogPosting' : 'Article',
    path: route.path,
    lang,
    headline: doc.title,
    description: doc.excerpt,
    image: imageInfo,
    datePublished: doc.publishedAt,
    dateModified: modified,
    authors: doc.authors,
    category: doc.category,
    mentions: mentionNodes(doc.mentions, content.glossary),
    sources: doc.sources,
    keywords: doc.seo?.focusKeyword,
    wordCount: fullText.split(/\s+/).length,
    translations: doc.translations,
    docType: doc._type,
  }),
  ...people.map((a, i) => personNode(a, lang, peopleImages[i]?.url)),
  comparison ? comparisonListNode(route.path, comparison.items ?? [], lang) : undefined,
  review ? productReviewNodes({ path: route.path, lang, review, productImage: productImage?.url }) : undefined,
  faqNode(route.path, faq),
]

const tocExtra = [
  ...(comparison ? [{ id: 'ranking-title', label: s.ranking }] : []),
  ...(faq.length ? [{ id: 'faq-title', label: s.faq }] : []),
  ...(doc.sources?.length ? [{ id: 'sources-title', label: s.sources }] : []),
]
---

<BaseLayout
  lang={lang}
  title={doc.title}
  description={doc.excerpt}
  route={route}
  seo={doc.seo}
  image={doc.mainImage}
  ogType="article"
  article={{ publishedTime: doc.publishedAt, modifiedTime: modified, section: categoryName }}
  jsonLd={jsonLd}
>
  <ArticleLayout
    lang={lang}
    title={doc.title}
    kicker={doc.category && categoryName ? { label: categoryName, href: categoryPath(doc.category, lang) } : undefined}
    image={doc.mainImage}
    hasAside
  >
    <Breadcrumbs slot="breadcrumbs" crumbs={crumbs} lang={lang} />
    <Byline
      slot="meta"
      lang={lang}
      authors={doc.authors}
      publishedAt={doc.publishedAt}
      updatedAt={doc.updatedAt}
      minutes={minutes}
      reviewedBy={doc.reviewedBy}
    />
    <ShortAnswer slot="lead" text={doc.excerpt} lang={lang} />
    <Toc slot="aside" body={[...(comparison?.intro ?? []), ...(doc.body ?? [])]} lang={lang} extra={tocExtra} />

    <KeyTakeaways items={doc.keyTakeaways} lang={lang} />
    {review && <ReviewSummary review={review} lang={lang} />}
    {comparison?.intro && <RichText value={comparison.intro} />}
    {comparison && <ComparisonList items={comparison.items ?? []} lang={lang} />}
    {
      comparison?.comparisonTable?.rows?.length ? (
        <section aria-labelledby="comparison-table-title">
          <h2 id="comparison-table-title">{s.comparisonTable}</h2>
          <Table table={comparison.comparisonTable} />
        </section>
      ) : null
    }
    <RichText value={doc.body} />
    <Faq items={faq} lang={lang} />
    <Sources sources={doc.sources} lang={lang} />
    <AuthorBox authors={doc.authors} lang={lang} policyHref={policyHref} />

    <Related
      slot="after"
      items={related}
      lang={lang}
      title={categoryName && !(doc.related?.length) ? s.moreOnTopic(categoryName) : undefined}
    />
  </ArticleLayout>
</BaseLayout>
