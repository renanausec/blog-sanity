---
/** „Das Wichtigste in Kürze“ – Kernaussagen als Liste (GEO: einzeln zitierbar) */
import { t } from '../../lib/i18n'
import type { LocaleId } from '../../lib/types'

interface Props {
  items: string[] | undefined
  lang: LocaleId
}
const { items = [], lang } = Astro.props
---

{
  items.length > 0 && (
    <section class="takeaways" aria-labelledby="takeaways-title">
      <h2 id="takeaways-title" class="takeaways__title">{t(lang).keyTakeaways}</h2>
      <ul>
        {items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .takeaways {
    padding: var(--space-4) var(--space-5);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .takeaways__title {
    font-size: var(--text-base);
    margin-bottom: var(--space-3);
  }
  .takeaways ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
  }
  .takeaways li {
    position: relative;
    padding-left: 1.75em;
  }
  .takeaways li::before {
    content: '✓';
    position: absolute;
    left: 0;
    font-weight: 700;
    color: var(--color-primary);
  }
</style>
