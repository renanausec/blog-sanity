---
import { paginatedPath } from '../../../../shared/routing'
import { t } from '../../lib/i18n'
import type { ListData } from '../../lib/routes'
import type { LocaleId } from '../../lib/types'

interface Props {
  list: ListData
  lang: LocaleId
}
const { list, lang } = Astro.props
const s = t(lang)
const prev = list.page > 1 ? paginatedPath(list.basePath, lang, list.page - 1) : undefined
const next = list.page < list.totalPages ? paginatedPath(list.basePath, lang, list.page + 1) : undefined
---

{
  list.totalPages > 1 && (
    <nav class="pagination" aria-label={s.pagination}>
      {prev ? (
        <a class="button button--ghost" href={prev} rel="prev">
          ← {s.previous}
        </a>
      ) : (
        <span />
      )}
      <span class="pagination__status">{s.page(list.page, list.totalPages)}</span>
      {next ? (
        <a class="button button--ghost" href={next} rel="next">
          {s.next} →
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}
