---
/** Autor(en), Datum, Aktualisierung, Lesezeit */
import { docPath } from '../../../../shared/routing'
import { formatDate, t } from '../../lib/i18n'
import type { Author, LocaleId } from '../../lib/types'

interface Props {
  lang: LocaleId
  authors: Author[]
  publishedAt: string
  updatedAt?: string
  minutes?: number
}
const { lang, authors, publishedAt, updatedAt, minutes } = Astro.props
const s = t(lang)
---

<p class="meta byline">
  {
    authors.length > 0 && (
      <span>
        {s.by}{' '}
        {authors.map((a, i) => (
          <>
            {i > 0 && (i === authors.length - 1 ? ` ${s.and} ` : ', ')}
            <a href={docPath('author', lang, a.slug)} rel="author">
              {a.name}
            </a>
          </>
        ))}
      </span>
    )
  }
  <span>
    {s.publishedOn} <time datetime={publishedAt}>{formatDate(publishedAt, lang)}</time>
  </span>
  {
    updatedAt && updatedAt.slice(0, 10) !== publishedAt.slice(0, 10) && (
      <span>
        {s.updatedOn} <time datetime={updatedAt}>{formatDate(updatedAt, lang)}</time>
      </span>
    )
  }
  {minutes && <span>{s.minutesRead(minutes)}</span>}
</p>

<style>
  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }
  .byline a {
    color: var(--color-text);
    font-weight: var(--weight-bold);
  }
</style>
