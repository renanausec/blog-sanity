---
import { t } from '../../lib/i18n'
import type { LocaleId } from '../../lib/types'

interface Props {
  value: number
  lang: LocaleId
}
const { value, lang } = Astro.props
const label = t(lang).ratingOf(value)
---

<span class="rating" style={`--rating: ${value}`}>
  <span class="rating__stars" aria-hidden="true">★★★★★</span>
  <span>{value.toLocaleString(lang === 'de' ? 'de-DE' : 'en-US')}<span class="visually-hidden"> – {label}</span></span>
</span>
