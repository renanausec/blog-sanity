---
/** Glossarbegriffe als Linkleiste (interne Verlinkung auf Hub- und Listenseiten) */
import { docPath } from '../../../../shared/routing'
import { t } from '../../lib/i18n'
import type { GlossaryTerm, LocaleId } from '../../lib/types'

interface Props {
  terms: GlossaryTerm[]
  lang: LocaleId
  title?: string
  showAll?: boolean
}
const { terms, lang, title, showAll = true } = Astro.props
const s = t(lang)
---

{
  terms.length > 0 && (
    <section class="chips" aria-labelledby="chips-title">
      <h2 id="chips-title" class="chips__title">{title ?? s.importantTerms}</h2>
      <ul>
        {terms.map((term) => (
          <li>
            <a href={docPath('glossaryTerm', lang, term.slug)} title={term.shortDefinition}>
              {term.title}
            </a>
          </li>
        ))}
        {showAll && (
          <li>
            <a class="chips__all" href={docPath('glossaryIndex', lang)}>
              {s.allTerms} →
            </a>
          </li>
        )}
      </ul>
    </section>
  )
}

<style>
  .chips__title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-3);
  }
  .chips ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chips a {
    display: inline-block;
    padding: var(--space-2) var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-button);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .chips a:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .chips .chips__all {
    border-style: dashed;
    color: var(--color-link);
  }
</style>
