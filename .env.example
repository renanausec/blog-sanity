# Umgebungsvariablen – Vorlage
# Kopieren nach .env (lokal) bzw. in Cloudflare Pages → Settings → Environment variables eintragen.
# .env wird nie committet.

# ─── Frontend-Build (web/) ──────────────────────────────────────────────
# Lese-Token für das private Dataset (Sanity → API → Tokens → Rolle "Viewer").
# Wird nur beim Build verwendet und landet nie im ausgelieferten HTML.
SANITY_API_READ_TOKEN=

# Optional: überschreibt site.config.ts → url, z. B. solange die Domain noch fehlt
# (SITE_URL=https://<projekt>.pages.dev). Weicht die Domain von site.config.ts ab,
# wird die ganze Website automatisch auf noindex gesetzt (robots.txt: Disallow).
# SITE_URL=https://tekpixo.com

# Wird von Cloudflare Pages automatisch gesetzt. Alles außer "main" erhält ebenfalls noindex.
# CF_PAGES_BRANCH=main

# ─── Studio (studio/) ───────────────────────────────────────────────────
# Keine Variablen nötig: Project ID und Dataset kommen aus site.config.ts,
# die Anmeldung läuft über den Sanity-Login.

# ─── Veröffentlichung (nur lokal, nicht in Cloudflare eintragen) ────────
# Deploy-Hook von Cloudflare Pages: Projekt → Settings → Build → Deploy hooks → Add (Branch: main).
# Wird einmalig genutzt, um den Sanity-Webhook anzulegen (Veröffentlichen → Rebuild). Geheim halten!
# CF_DEPLOY_HOOK=

# ─── Skripte / MCP (optional) ───────────────────────────────────────────
# Schreib-Token (Rolle "Editor"), nur für lokale Skripte. Niemals in Cloudflare eintragen.
# SANITY_API_WRITE_TOKEN=
